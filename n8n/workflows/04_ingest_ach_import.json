{
  "name": "Ingest ACH (CSV)",
  "nodes": [
    {
      "id": "1",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 100],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 2,
              "minute": 0
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Read CSV",
      "type": "n8n-nodes-base.readBinaryFile",
      "typeVersion": 1,
      "position": [400, 100],
      "parameters": {
        "filePath": "/data/ach_imports/today.csv"
      }
    },
    {
      "id": "3",
      "name": "Parse CSV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [600, 100],
      "parameters": {
        "language": "python",
        "code": "# Parse CSV from binary input into ledger rows\nimport csv, io\nitems_out = []\n# assume binary data in first item\ncsv_bytes = items[0]['binary']['data']\ncsv_str = csv_bytes.decode('utf-8')\nreader = csv.DictReader(io.StringIO(csv_str))\nfor row in reader:\n    gross = float(row.get('amount'))\n    fees = float(row.get('fee', 0))\n    ledger = {\n        'processor': 'ach',\n        'processor_account_id': 4,\n        'external_id': row.get('transaction_id'),\n        'type': row.get('type'),\n        'gross_amount': gross,\n        'fee_amount': fees,\n        'net_amount': gross - fees,\n        'currency': row.get('currency'),\n        'occurred_at': row.get('date'),\n        'customer_ref': row.get('customer_ref'),\n        'description': row.get('description'),\n        'status': row.get('status')\n    }\n    items_out.append({'json': ledger})\nreturn items_out"
      }
    },
    {
      "id": "4",
      "name": "Supabase Upsert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [800, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "upsert",
        "table": "ledger_transactions",
        "columns": "processor,processor_account_id,external_id,type,gross_amount,fee_amount,net_amount,currency,occurred_at,customer_ref,description,status",
        "values": "={{ Object.values($json).join(',') }}",
        "schema": "public"
      }
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Read CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read CSV": {
      "main": [
        [
          {
            "node": "Parse CSV",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse CSV": {
      "main": [
        [
          {
            "node": "Supabase Upsert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
