{
  "name": "Ingest Square",
  "nodes": [
    {
      "id": "1", "name": "Cron", "type": "n8n-nodes-base.cron", "typeVersion": 1,
      "position": [200, 100],
      "parameters": {"triggerTimes": {"item": [{"mode": "everyDay", "hour": 1, "minute": 30}]}}
    },
    {
      "id": "2", "name": "HTTP Request: Square", "type": "n8n-nodes-base.httpRequest", "typeVersion": 2,
      "position": [400, 100], "credentials": {"httpHeaderAuth": {"id": "square-api-credentials"}},
      "parameters": {
        "url": "https://connect.squareup.com/v2/payments", "method": "GET",
        "queryParametersUi": {"parameter": [
          {"name": "begin_time", "value": "={{ $now.minus(days=1).toISO() }}"},
          {"name": "end_time", "value": "={{ $now.toISO() }}"},
          {"name": "sort_order", "value": "ASC"}
        ]}
      }
    },
    {
      "id": "3", "name": "Normalize Square Batch", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4,
      "position": [600, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RECONCILIATION_ENGINE_URL || 'http://reconciliation-engine:8000' }}/normalize",
        "sendBody": true, "specifyBody": "json",
        "jsonBody": "={{ { processor: 'square', account_id: '3', records: $json.payments || [] } }}"
      }
    },
    {
      "id": "4", "name": "Split Normalized Records", "type": "n8n-nodes-base.splitOut", "typeVersion": 1,
      "position": [800, 100], "parameters": {"fieldToSplitOut": "records", "options": {}}
    },
    {
      "id": "5", "name": "Upsert Ledger", "type": "n8n-nodes-base.supabase", "typeVersion": 1,
      "position": [1000, 100], "credentials": {"supabaseApi": {"id": "supabase-credentials"}},
      "parameters": {
        "operation": "upsert", "table": "ledger_transactions", "schema": "public",
        "columns": "processor,processor_account_id,external_id,type,gross_amount,fee_amount,net_amount,currency,occurred_at,customer_ref,description,status",
        "values": "={{ [$json.records.source,$json.records.account_id,$json.records.external_id,$json.records.kind,$json.records.gross_amount,$json.records.fee_amount,$json.records.net_amount,$json.records.currency,$json.records.occurred_at,$json.records.reference || '',JSON.stringify($json.records.metadata),'normalized'].join(',') }}"
      }
    }
  ],
  "connections": {
    "Cron": {"main": [[{"node": "HTTP Request: Square", "type": "main", "index": 0}]]},
    "HTTP Request: Square": {"main": [[{"node": "Normalize Square Batch", "type": "main", "index": 0}]]},
    "Normalize Square Batch": {"main": [[{"node": "Split Normalized Records", "type": "main", "index": 0}]]},
    "Split Normalized Records": {"main": [[{"node": "Upsert Ledger", "type": "main", "index": 0}]]}
  }
}
