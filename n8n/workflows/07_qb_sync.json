{
  "name": "QuickBooks Sync",
  "nodes": [
    {
      "id": "1",
      "name": "Approved Journal Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 100],
      "webhookId": "approved-accounting-journal",
      "credentials": {
        "httpHeaderAuth": {
          "id": "accounting-approval-header-auth"
        }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "approved-accounting-journal",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "2",
      "name": "Validate Approved Journal",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [450, 100],
      "parameters": {
        "language": "python",
        "code": "# Amounts must come from approved financial records; confidence is never money.\nrequired = ['run_id', 'idempotency_key', 'payload_sha256', 'journal']\nout = []\nfor item in items:\n    row = item['json'].get('body', item['json'])\n    missing = [key for key in required if not row.get(key)]\n    if missing:\n        raise ValueError(f\"Missing approved journal fields: {missing}\")\n    journal = row['journal']\n    if journal.get('debit_total') != journal.get('credit_total'):\n        raise ValueError('Journal is not balanced')\n    out.append({'json': row})\nreturn out"
      }
    },
    {
      "id": "3",
      "name": "Upsert QB Sync Job",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [700, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "upsert",
        "table": "qb_sync_jobs",
        "schema": "public",
        "columns": "run_id,idempotency_key,payload_sha256,status,qb_payload_json",
        "values": "={{ $json.run_id }},{{ $json.idempotency_key }},{{ $json.payload_sha256 }},pending,{{ $json.journal }}"
      }
    }
  ],
  "connections": {
    "Approved Journal Webhook": {
      "main": [
        [
          {
            "node": "Validate Approved Journal",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Approved Journal": {
      "main": [
        [
          {
            "node": "Upsert QB Sync Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
