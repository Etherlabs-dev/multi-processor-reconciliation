{
  "name": "Reconcile & Match Engine",
  "nodes": [
    {
      "id": "1",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 100],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 4,
              "minute": 0
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Create Recon Run",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [400, 80],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "insert",
        "table": "recon_runs",
        "schema": "public",
        "columns": "time_window_start,time_window_end,processors_included,input_fingerprint,stats",
        "values": "={{ $today.minus(days=1).toISO() }},{{ $today.toISO() }},{{ ['stripe','paypal','square','ach'] }},{{ $('Reconcile via Engine').first().json.input_fingerprint }},{{ $('Reconcile via Engine').first().json.stats }}"
      }
    },
    {
      "id": "3",
      "name": "Load Transactions",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [400, 140],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "select",
        "table": "ledger_transactions",
        "schema": "public",
        "columns": "*",
        "conditions": "occurred_at >= '{{ $today.minus(days=1).toISO() }}' AND occurred_at < '{{ $today.toISO() }}'"
      }
    },
    {
      "id": "4",
      "name": "Load Payouts",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [400, 200],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "select",
        "table": "payouts",
        "schema": "public",
        "columns": "*",
        "conditions": "payout_date >= '{{ $today.minus(days=1).toISODateString() }}' AND payout_date <= '{{ $today.toISODateString() }}'"
      }
    },
    {
      "id": "5",
      "name": "Reconcile via Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [650, 160],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RECONCILIATION_ENGINE_URL || 'http://reconciliation-engine:8000' }}/reconcile",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { left: $items('Load Transactions').map(i => i.json), right: $items('Load Payouts').map(i => ({ processor: i.json.processor, processor_account_id: i.json.processor_account_id, external_id: i.json.external_id, kind: 'payout', gross_amount: i.json.payout_amount, fee_amount: 0, net_amount: i.json.payout_amount, currency: i.json.currency, occurred_at: i.json.payout_date })) } }}"
      }
    },
    {
      "id": "6",
      "name": "Insert Matches",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 120],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "upsert",
        "table": "recon_matches",
        "schema": "public",
        "columns": "run_id,match_key,left_entity_type,left_entity_id,right_entity_type,right_entity_id,confidence,reason",
        "values": "={{ $('Reconcile via Engine').first().json.matches.map(m => `${$('Create Recon Run').first().json.id},${m.left_ids.join('+')}::${m.right_ids.join('+')},transaction,${m.left_ids.join('+')},payout,${m.right_ids.join('+')},${m.score},${m.classification}`).join(';') }}"
      }
    },
    {
      "id": "7",
      "name": "Insert Exceptions",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 200],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "upsert",
        "table": "recon_exceptions",
        "schema": "public",
        "columns": "run_id,exception_type,severity,entity_ref,details_json",
        "values": "={{ $('Reconcile via Engine').first().json.discrepancies.map(e => `${$('Create Recon Run').first().json.id},${e.classification},medium,${e.record_ids.join('+')},${JSON.stringify(e.details || {})}`).join(';') }}"
      }
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Load Transactions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Transactions": {
      "main": [
        [
          {
            "node": "Load Payouts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Load Payouts": {
      "main": [
        [
          {
            "node": "Reconcile via Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reconcile via Engine": {
      "main": [
        [
          {
            "node": "Create Recon Run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Recon Run": {
      "main": [
        [
          {
            "node": "Insert Matches",
            "type": "main",
            "index": 0
          },
          {
            "node": "Insert Exceptions",
            "type": "main",
            "index": 1
          }
        ]
      ]
    }
  }
}
