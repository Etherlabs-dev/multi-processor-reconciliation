{
  "name": "Ingest Stripe",
  "nodes": [
    {
      "id": "1",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 100],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 1,
              "minute": 0
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "HTTP Request: Stripe",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [400, 100],
      "credentials": {
        "httpBasicAuth": {
          "id": "stripe-api-credentials"
        }
      },
      "parameters": {
        "url": "https://api.stripe.com/v1/balance_transactions",
        "method": "GET",
        "queryParametersUi": {
          "parameter": [
            {
              "name": "limit",
              "value": "100"
            },
            {
              "name": "starting_after",
              "value": "={{ $json[\"cursor\"] || '' }}"
            }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Transform to Ledger",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [600, 100],
      "parameters": {
        "language": "python",
        "code": "# This node receives the raw Stripe response and converts it into canonical ledger rows\nimport json\nitems_out = []\nfor item in items:\n    data = item.get('response', {}).get('data', [])\n    for event in data:\n        ledger = {\n            'processor': 'stripe',\n            'processor_account_id': 1,  # update accordingly\n            'external_id': event.get('id'),\n            'type': event.get('type'),\n            'gross_amount': float(event.get('amount', 0)) / 100.0,\n            'fee_amount': float(event.get('fee', 0)) / 100.0,\n            'net_amount': float(event.get('net', 0)) / 100.0,\n            'currency': event.get('currency', '').upper(),\n            'occurred_at': event.get('created'),\n            'customer_ref': event.get('source', ''),\n            'description': event.get('description', ''),\n            'status': 'succeeded'\n        }\n        items_out.append({'json': ledger})\nreturn items_out"
      }
    },
    {
      "id": "4",
      "name": "Supabase Upsert",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [800, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "upsert",
        "table": "ledger_transactions",
        "columns": "processor,processor_account_id,external_id,type,gross_amount,fee_amount,net_amount,currency,occurred_at,customer_ref,description,status",
        "values": "={{ Object.values($json).join(',') }}",
        "schema": "public"
      }
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "HTTP Request: Stripe",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request: Stripe": {
      "main": [
        [
          {
            "node": "Transform to Ledger",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transform to Ledger": {
      "main": [
        [
          {
            "node": "Supabase Upsert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
