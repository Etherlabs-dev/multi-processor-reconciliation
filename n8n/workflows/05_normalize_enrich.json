{
  "name": "Normalize & Enrich",
  "nodes": [
    {
      "id": "1",
      "name": "Cron",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [200, 100],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "mode": "everyDay",
              "hour": 3,
              "minute": 0
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "Query Raw Events",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [400, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "select",
        "table": "raw_events",
        "schema": "public",
        "columns": "id,processor,processor_account_id,event_type,external_id,payload_json,created_at"
      }
    },
    {
      "id": "3",
      "name": "Normalize via Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [600, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RECONCILIATION_ENGINE_URL || 'http://reconciliation-engine:8000' }}/normalize",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { processor: $json.processor, account_id: String($json.processor_account_id), records: [$json.payload_json] } }}"
      }
    },
    {
      "id": "4",
      "name": "Upsert Enriched Rows",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [800, 100],
      "credentials": {
        "supabaseApi": {
          "id": "supabase-credentials"
        }
      },
      "parameters": {
        "operation": "upsert",
        "table": "ledger_transactions",
        "schema": "public",
        "columns": "processor,processor_account_id,external_id,type,gross_amount,fee_amount,net_amount,currency,occurred_at,customer_ref,description,status",
        "values": "={{ [$json.record.source,$json.record.account_id,$json.record.external_id,$json.record.kind,$json.record.gross_amount,$json.record.fee_amount,$json.record.net_amount,$json.record.currency,$json.record.occurred_at,$json.record.reference || '',JSON.stringify($json.record.metadata), 'normalized'].join(',') }}"
      }
    }
  ],
  "connections": {
    "Cron": {
      "main": [
        [
          {
            "node": "Query Raw Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Raw Events": {
      "main": [
        [
          {
            "node": "Normalize via Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize via Engine": {
      "main": [
        [
          {
            "node": "Upsert Enriched Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
